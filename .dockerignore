# Allow only module/build inputs and the two deployment binaries. Scenario state, local
# credentials, .git -- stays out of the build context, which keeps builds small
# and keeps secrets from ever reaching a builder.
*
!go.mod
!go.sum
!deploy/voptrack-init
!cmd/console
!cmd/deployctl
!internal/backupsettings

!cmd/backupcollector
!internal/acquisitionclient
!internal/backupcollector
!cmd/recoverykit
!internal/recoverymaterial
!internal/recoverykit
!internal/runtimeobs

!internal/schedulerclient/
!internal/schedulerclient/*.go

!cmd/recoveryset
!internal/recoveryset

!cmd/recovery
!internal/guidedrecovery

!cmd/backupreplicator
!internal/backupreplication

!internal/homesetup
!cmd/homesetup

!deploy/identity-brand/
!deploy/identity-brand/voptrack-mark.png
!internal/identitybrand/
!internal/identitybrand/*.go

!internal/websignin/
!internal/websignin/*.go

!catalogue/
catalogue/1/

!LICENSE
!THIRD-PARTY.md
!deploy/collect-licenses.sh
