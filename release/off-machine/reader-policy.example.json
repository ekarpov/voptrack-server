{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::APPROVED_BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["APPROVED_PREFIX/*"]}}
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::APPROVED_BUCKET/APPROVED_PREFIX/*"
    },
    {
      "Effect": "Deny",
      "Action": ["s3:Put*", "s3:Delete*"],
      "Resource": "*"
    }
  ]
}
