# Local CI on the shared Linux test host (ci/remote.sh sources this there).
# The host's rules: Docker's published ports bypass its firewall, so every one
# binds to 127.0.0.1; ours are 8450-8459 (servers) and 55440-55449
# (databases). Containers are named voptrack-* and the shared cache is
# preserved. Gates that use the same ports run serially.

VOPTRACK_PUBLISH_PREFIX=127.0.0.1:
VOPTRACK_CI_PRUNE=no
VOPTRACK_SCENARIO_PROJECT=voptrack-scenario

# Gates: HTTP 8450, HTTPS 8451, a Console's own port 8452, a bare server 8453.
VOPTRACK_RELEASE_HTTP_PORT=8450
VOPTRACK_RELEASE_HTTPS_PORT=8451
VOPTRACK_HOUSEHOLD_HTTP_PORT=8450
VOPTRACK_HOUSEHOLD_HTTPS_PORT=8451
VOPTRACK_CONSOLE_HTTP_PORT=8450
VOPTRACK_CONSOLE_HTTPS_PORT=8451
VOPTRACK_RESEARCH_HTTP_PORT=8450
VOPTRACK_RESEARCH_HTTPS_PORT=8451
VOPTRACK_RECOVERY_HTTP_PORT=8450
VOPTRACK_RECOVERY_HTTPS_PORT=8451
VOPTRACK_RECOVERY_CONSOLE_PORT=8452
VOPTRACK_HOMEAPP_HTTP_PORT=8450
VOPTRACK_HOMEAPP_HTTPS_PORT=8451
VOPTRACK_HOMEAPP_CONSOLE_PORT=8452
VOPTRACK_PRIVATE_HTTP_PORT=8450
VOPTRACK_PRIVATE_HTTPS_PORT=8451
VOPTRACK_PRIVATE_CONSOLE_PORT=8452
VOPTRACK_BACKUP_PORT=8453
VOPTRACK_PG_SERVER_PORT=8453
VOPTRACK_PG_PORT=55440

# The dev-server checks' disposable copies.
VOPTRACK_HOME_DEV_HTTP_PORT=8450
VOPTRACK_HOME_DEV_PORT=8451
VOPTRACK_HOME_DEV_CONSOLE_PORT=8452
VOPTRACK_RESEARCH_DEV_HTTP_PORT=8450
VOPTRACK_RESEARCH_DEV_PORT=8451
VOPTRACK_RESEARCH_DEV_CONSOLE_PORT=8452

# Scenarios: the deployment, and the disposable twin it is verified against.
VOPTRACK_HTTP_PORT=8450
VOPTRACK_HTTPS_PORT=8451
VOPTRACK_TRY_PORT=8451
VOPTRACK_TRY_HTTP_PORT=8450
VOPTRACK_TWIN_PORT=8455
VOPTRACK_TWIN_HTTP_PORT=8454

# Gates that do not choose a Console port of their own would publish 9443.
VOPTRACK_CONSOLE_PORT=8452

# Native scheduler and constrained kit gate uses the same disposable range.
VOPTRACK_KIT_HTTP_PORT=8450
VOPTRACK_KIT_HTTPS_PORT=8451
VOPTRACK_KIT_CONSOLE_PORT=8452
