{
  "about": "Home aggregation vectors, v1. The inputs and answers of voptrack-server's Home gate (release/console/drive.py), as the Console computes them (cmd/console/numbers.go, dashboard.go). For the Voptrack app to check its own Home aggregation against. Values are exact decimals as strings: an integer as it is, otherwise to at most twelve places with trailing zeros dropped. 'null' means a gap: no records, not zero. Checked by TestHomeVectors in cmd/console.",
  "rules": [
    "Sum, count, minimum and maximum combine across members exactly.",
    "An average is the total over the count of values, across all members' records -- never an average of per-member averages.",
    "A period with no records is a gap (null), not zero.",
    "Periods are bucketed in the household's timezone; these vectors use UTC.",
    "Only tracks a member shared with Home are aggregated: a track nobody shared is absent, not empty.",
    "A person reading their own store ('mine') sees all of their own tracks, shared or not."
  ],
  "types": {
    "org.voptrack.gate.spending": {
      "fields": {
        "recorded_at": "date_time",
        "amount": "fixed(2)",
        "category": "text"
      }
    },
    "org.voptrack.gate.weight": {
      "fields": {
        "recorded_at": "date_time",
        "kg": "float"
      }
    }
  },
  "members": {
    "sara": {
      "shares": [
        "org.voptrack.gate.spending"
      ],
      "records": {
        "org.voptrack.gate.spending": [
          {
            "recorded_at": "2026-07-15T09:00:00.000Z",
            "amount": "12.5",
            "category": "food"
          },
          {
            "recorded_at": "2026-08-10T09:00:00.000Z",
            "amount": "0.1",
            "category": "food"
          },
          {
            "recorded_at": "2026-08-20T09:00:00.000Z",
            "amount": "0.2",
            "category": "transport"
          }
        ],
        "org.voptrack.gate.weight": [
          {
            "recorded_at": "2026-09-01T07:00:00.000Z",
            "kg": "61.2"
          },
          {
            "recorded_at": "2026-09-01T07:00:00.000Z",
            "kg": "60.8"
          }
        ]
      }
    },
    "ben": {
      "shares": [
        "org.voptrack.gate.spending"
      ],
      "records": {
        "org.voptrack.gate.spending": [
          {
            "recorded_at": "2026-08-11T09:00:00.000Z",
            "amount": "100",
            "category": "food"
          },
          {
            "recorded_at": "2026-09-05T09:00:00.000Z",
            "amount": "0.25",
            "category": "food"
          }
        ],
        "org.voptrack.gate.weight": [
          {
            "recorded_at": "2026-09-01T07:00:00.000Z",
            "kg": "80.1"
          }
        ]
      }
    }
  },
  "cases": [
    {
      "name": "home spending total",
      "scope": "home",
      "type": "org.voptrack.gate.spending",
      "field": "amount",
      "measure": "sum",
      "group": "none",
      "expect": {
        "All": "113.05"
      }
    },
    {
      "name": "home spending per member",
      "scope": "home",
      "type": "org.voptrack.gate.spending",
      "field": "amount",
      "measure": "sum",
      "group": "member",
      "expect": {
        "sara": "12.8",
        "ben": "100.25"
      }
    },
    {
      "name": "home spending by category",
      "scope": "home",
      "type": "org.voptrack.gate.spending",
      "field": "amount",
      "measure": "sum",
      "group": "category",
      "expect": {
        "food": "112.85",
        "transport": "0.2"
      }
    },
    {
      "name": "home spending by month, June a gap",
      "scope": "home",
      "type": "org.voptrack.gate.spending",
      "field": "amount",
      "measure": "sum",
      "group": "month",
      "expect": {
        "2026-06": null,
        "2026-07": "12.5",
        "2026-08": "100.3",
        "2026-09": "0.25"
      },
      "from": "2026-06-01",
      "to": "2026-09-30",
      "tz": "UTC"
    },
    {
      "name": "home spending average, total over count",
      "scope": "home",
      "type": "org.voptrack.gate.spending",
      "field": "amount",
      "measure": "average",
      "group": "none",
      "expect": {
        "All": "22.61"
      }
    },
    {
      "name": "home spending count",
      "scope": "home",
      "type": "org.voptrack.gate.spending",
      "field": "amount",
      "measure": "count",
      "group": "none",
      "expect": {
        "All": "5"
      }
    },
    {
      "name": "home spending largest",
      "scope": "home",
      "type": "org.voptrack.gate.spending",
      "field": "amount",
      "measure": "maximum",
      "group": "none",
      "expect": {
        "All": "100"
      }
    },
    {
      "name": "home weight, shared by nobody",
      "scope": "home",
      "type": "org.voptrack.gate.weight",
      "field": "kg",
      "measure": "average",
      "group": "none",
      "expect": null,
      "note": "absent: the track is not offered to Home at all"
    },
    {
      "name": "sara's own weight average",
      "scope": "mine:sara",
      "type": "org.voptrack.gate.weight",
      "field": "kg",
      "measure": "average",
      "group": "none",
      "expect": {
        "All": "61"
      }
    },
    {
      "name": "sara's own spending total",
      "scope": "mine:sara",
      "type": "org.voptrack.gate.spending",
      "field": "amount",
      "measure": "sum",
      "group": "none",
      "expect": {
        "All": "12.8"
      }
    }
  ]
}