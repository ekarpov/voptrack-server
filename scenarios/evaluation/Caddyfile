# Public TLS terminates here. Caddy obtains and renews a certificate
# automatically: Let's Encrypt for a real domain, its own internal CA for
# localhost, with no configuration difference between them.
{$VOPTRACK_DOMAIN:localhost} {
	encode gzip

	# The internal hop is re-encrypted rather than plaintext, because tesserad
	# refuses to start without a certificate and key -- it has no plaintext
	# listener to proxy to. Verification is skipped on this hop alone: it is
	# container-to-container on a private compose network, the certificate is
	# the self-signed one generated by `make scenario-single-user-init`, and
	# the alternative Caddy offers is not "verified" but "unencrypted".
	reverse_proxy https://tesserad:8443 {
		transport http {
			tls
			tls_insecure_skip_verify
		}
		header_up X-Forwarded-Proto https
	}
}
